{
    "name":  "english-learning-app",
    "private":  true,
    "packageManager":  "pnpm@11.17.0",
    "scripts":  {
                    "dev":  "turbo dev",
                    "dev:mobile":  "corepack pnpm --filter @english-coach/mobile start",
                    "dev:server":  "corepack pnpm --filter @english-coach/server dev",
                    "android":  "corepack pnpm --filter @english-coach/mobile android",
                    "ios":  "corepack pnpm --filter @english-coach/mobile ios",
                    "web":  "corepack pnpm --filter @english-coach/mobile web",
                    "lint":  "turbo lint",
                    "typecheck":  "turbo typecheck",
                    "format":  "prettier --write .",
                    "format:check":  "prettier --check .",
                    "db:generate":  "corepack pnpm --filter @english-coach/database db:generate",
                    "db:migrate":  "corepack pnpm --filter @english-coach/database db:migrate",
                    "db:push":  "corepack pnpm --filter @english-coach/database db:push",
                    "db:studio":  "corepack pnpm --filter @english-coach/database db:studio",
                    "build:apk":  "cd apps/mobile && corepack pnpm dlx eas-cli build --platform android --profile preview"
                },
    "devDependencies":  {
                            "@babel/core":  "7.28.5",
                            "@babel/generator":  "7.28.5",
                            "@babel/traverse":  "7.28.5",
                            "@babel/types":  "7.28.5",
                            "prettier":  "latest",
                            "prettier-plugin-tailwindcss":  "latest",
                            "turbo":  "latest",
                            "typescript":  "latest"
                        }
}
